NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_TARGET_ENVIRONMENT=
EMAIL_PROVIDER=resend
RESEND_API_KEY=
GMAIL_SMTP_USER=
GMAIL_SMTP_APP_PASSWORD=
EMAIL_FROM=
EMAIL_REPLY_TO=
EMAIL_SENDING_ENABLED=
EMAIL_DAILY_LIMIT=350
EMAIL_BATCH_SIZE=5
EMAIL_TIMEZONE=Asia/Kolkata
# Staging only. When true, send to the email supplied in the public form.
# Production refuses this staging-specific switch.
EMAIL_STAGING_PUBLIC_RECIPIENTS_ENABLED=false
# Comma-separated, maximum five. Used only when SUPABASE_TARGET_ENVIRONMENT=staging.
EMAIL_TEST_RECIPIENTS=
# Backward-compatible single-recipient fallback.
EMAIL_TEST_RECIPIENT=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ENABLED=false
ABUSE_HASH_SECRET=
INTERNAL_CRON_SECRET=
CRON_SECRET=
RESEND_WEBHOOK_SECRET=
