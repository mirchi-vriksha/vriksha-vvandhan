{
  "name": "vriksha-vvandhan-campaign",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset --local",
    "db:lint": "supabase db lint --local --level warning",
    "db:test": "supabase test db --local supabase/tests/database",
    "db:types": "supabase gen types --local --schema public,private > src/lib/supabase/database.types.ts",
    "db:types:check": "node scripts/check-database-types.mjs",
    "db:buckets:seed": "supabase seed buckets --local",
    "cleanup:drafts:dry-run": "node --env-file-if-exists=.env.local scripts/cleanup-expired-drafts.mjs",
    "cleanup:drafts": "node --env-file-if-exists=.env.local scripts/cleanup-expired-drafts.mjs --execute",
    "test:staging:submission": "node --env-file-if-exists=.env.local scripts/test-staging-submission.mjs",
    "staff:bootstrap": "node --env-file-if-exists=.env.local scripts/bootstrap-staff-profile.mjs",
    "staff:password": "node --env-file-if-exists=.env.local scripts/update-staging-staff-password.mjs",
    "test:staging:moderation": "node --env-file-if-exists=.env.local scripts/staging-moderation-smoke.mjs",
    "staging:seed-demo": "node scripts/seed-staging-demo-data.mjs",
    "staging:cleanup-demo": "node scripts/cleanup-staging-demo-data.mjs",
    "staging:backfill-review-thumbnails": "node --env-file-if-exists=.env.local scripts/backfill-review-thumbnails.mjs",
    "staging:benchmark-review-thumbnails": "node --env-file-if-exists=.env.local scripts/benchmark-review-thumbnail-queue.mjs",
    "certificate:preview": "NODE_OPTIONS=--conditions=react-server tsx scripts/render-certificate-preview.ts",
    "test:staging:certificate-email": "NODE_OPTIONS=--conditions=react-server tsx --env-file-if-exists=.env.local scripts/staging-certificate-email-smoke.mjs",
    "test:export": "NODE_OPTIONS=--conditions=react-server tsx scripts/verify-campaign-export.ts",
    "test:load:public": "node scripts/load-test-public.mjs",
    "test:load:staging-workflows": "node --env-file-if-exists=.env.local scripts/load-test-staging-workflows.mjs"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.112.1",
    "browser-image-compression": "2.0.2",
    "clsx": "^2.1.1",
    "exceljs": "4.4.0",
    "heic-to": "1.5.2",
    "lucide-react": "^1.28.0",
    "next": "16.3.0",
    "nodemailer": "9.0.5",
    "pdf-lib": "1.17.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "6.18.1",
    "server-only": "0.0.1",
    "sharp": "0.35.3",
    "tailwind-merge": "^3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^20",
    "@types/nodemailer": "8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "jsdom": "^30.0.1",
    "supabase": "2.111.0",
    "tailwindcss": "^4",
    "tsx": "4.23.10",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
